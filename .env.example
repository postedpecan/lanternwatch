# Path overrides are optional. By default, Lanternwatch stores its database
# and runtime state in the current user's .lanternwatch directory.
# LANTERNWATCH_STORAGE_ROOT=C:\Users\you\.lanternwatch
# LANTERNWATCH_DB_PATH=C:\Users\you\.lanternwatch\guild.db

# Set a vault path to export completed runs as Markdown notes.
# LANTERNWATCH_VAULT_PATH=C:\Users\you\Documents\Obsidian Vault

LANTERNWATCH_STALE_AFTER_SECONDS=600
LANTERNWATCH_API_URL=http://127.0.0.1:3000/api/guild/events
